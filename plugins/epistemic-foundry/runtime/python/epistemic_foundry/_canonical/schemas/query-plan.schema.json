{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epistemic-foundry.local/schemas/query-plan.schema.json",
  "title": "QueryPlan",
  "description": "An immutable, class-bound retrieval plan whose selected lanes are derived from the canonical E0-E5 floor and sealed by plan_hash.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "lane": {
      "enum": [
        "lexical",
        "semantic",
        "citation",
        "entity_variable",
        "mechanism",
        "counterevidence",
        "null",
        "boundary",
        "method",
        "temporal",
        "external_novelty"
      ]
    },
    "lane_decision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lane": {
          "$ref": "#/$defs/lane"
        },
        "disposition": {
          "enum": [
            "SELECTED",
            "NOT_REQUIRED_FOR_CLASS",
            "NOT_APPLICABLE"
          ]
        },
        "decision_reason": {
          "enum": [
            "CLASS_FLOOR",
            "POLICY_SELECTED",
            "NOT_REQUIRED_FOR_CLASS",
            "NOT_APPLICABLE"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "lane",
        "disposition",
        "decision_reason",
        "evidence_ids"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "SELECTED"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "decision_reason": {
                "enum": [
                  "CLASS_FLOOR",
                  "POLICY_SELECTED"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "NOT_REQUIRED_FOR_CLASS"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "decision_reason": {
                "const": "NOT_REQUIRED_FOR_CLASS"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "NOT_APPLICABLE"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "decision_reason": {
                "const": "NOT_APPLICABLE"
              }
            }
          }
        }
      ]
    },
    "class_floor_lane_decision": {
      "properties": {
        "disposition": {
          "const": "SELECTED"
        },
        "decision_reason": {
          "const": "CLASS_FLOOR"
        }
      },
      "required": [
        "disposition",
        "decision_reason"
      ]
    },
    "not_required_lane_decision": {
      "properties": {
        "disposition": {
          "const": "NOT_REQUIRED_FOR_CLASS"
        },
        "decision_reason": {
          "const": "NOT_REQUIRED_FOR_CLASS"
        }
      },
      "required": [
        "disposition",
        "decision_reason"
      ]
    }
  },
  "properties": {

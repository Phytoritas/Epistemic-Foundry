    "canonical_relation": {
      "type": "string",
      "minLength": 1
    },
    "forward_queries": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reverse_queries": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "null_queries": {
      "type": "array",

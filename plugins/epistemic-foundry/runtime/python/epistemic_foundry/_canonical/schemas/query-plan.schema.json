    "required_lanes": {
      "type": "array",
      "maxItems": 11,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/lane"
      }
    },
    "lane_decisions": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "prefixItems": [

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epistemic-foundry.local/schemas/prediction-gene.schema.json",
  "title": "PredictionGene",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "prediction_gene_id": {
      "type": "string",
      "minLength": 1
    },
    "genome_id": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "scope_vector_id": {
      "type": "string",
      "minLength": 1
    },
    "observable_id": {
      "type": "string",
      "minLength": 1
    },
    "expected_direction": {
      "enum": [
        "increase",
        "decrease",
        "null",
        "nonmonotonic",
        "distribution_shift",
        "qualitative"
      ]
    },
    "expected_range": {
      "type": "string",
      "minLength": 1
    },
    "time_horizon": {
      "type": "string",
      "minLength": 1
    },
    "discrimination_targets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "pre_registered": {
      "type": "boolean"
    }
  },
  "required": [
    "prediction_gene_id",
    "genome_id",
    "statement",
    "scope_vector_id",
    "observable_id",
    "expected_direction",
    "expected_range",
    "time_horizon",
    "discrimination_targets",
    "pre_registered"
  ],
  "description": "가설이 내는 관측 가능한 정량·정성 예측을 정의한다."
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epistemic-foundry.local/schemas/replication-plan.schema.json",
  "title": "ReplicationPlan",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "replication_plan_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "replication_class": {
      "enum": [
        "independent_code",
        "independent_data",
        "independent_team",
        "cross_method",
        "cross_scope",
        "multi_seed"
      ]
    },
    "executor_independence": {
      "type": "string",
      "minLength": 1
    },
    "environment_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "data_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "seeds": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 1
    },
    "preregistered_metrics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "success_rule": {
      "type": "string",
      "minLength": 1
    },
    "failure_rule": {
      "type": "string",
      "minLength": 1
    },
    "plan_hash": {
      "type": "string",
      "minLength": 1,
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "replication_plan_id",
    "candidate_id",
    "replication_class",
    "executor_independence",
    "environment_ids",
    "data_ids",
    "seeds",
    "preregistered_metrics",
    "success_rule",
    "failure_rule",
    "plan_hash"
  ],
  "description": "독립 실행자·환경·데이터·seed·사전등록 기준을 갖춘 복제 계획을 정의한다."
}

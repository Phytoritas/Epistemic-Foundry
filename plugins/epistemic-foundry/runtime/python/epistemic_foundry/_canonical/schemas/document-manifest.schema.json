{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epistemic-foundry.local/schemas/document-manifest.schema.json",
  "title": "DocumentManifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "registration_id": {
      "type": "string",
      "pattern": "^DREG-[0-9a-f]{64}$"
    },
    "registration_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_blob_artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "source_artifact_receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "registration_artifact_receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "derived_from_registration_id": {
      "type": "string",
      "pattern": "^DREG-[0-9a-f]{64}$"
    },
    "supersedes_document_manifest_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "lineage_event_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "paper_id": {
      "type": "string",
      "minLength": 1
    },
    "paper_version_id": {
      "type": "string",
      "minLength": 1
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "original_filename": {
      "type": "string",
      "minLength": 1
    },
    "media_type": {
      "type": "string",
      "minLength": 1
    },
    "source_uri": {
      "type": [
        "string",
        "null"
      ]
    },
    "doi": {
      "type": [
        "string",
        "null"
      ]
    },
    "bibliographic_version": {
      "enum": [
        "preprint",
        "accepted_manuscript",
        "version_of_record",
        "correction",
        "retraction_notice",
        "other"
      ]
    },
    "supersedes_version_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "active",
        "corrected",
        "retracted",
        "withdrawn",
        "quarantined",
        "unknown"
      ]
    },
    "license_status": {
      "enum": [
        "licensed",
        "open_access",
        "fair_use_metadata_only",
        "restricted",
        "unknown"
      ]
    },
    "access_policy_ref": {
      "type": "string",
      "minLength": 1
    },
    "parser_artifact_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_integrity_report_id": {
      "type": "string",
      "minLength": 1
    },
    "malware_scan_status": {
      "enum": [
        "not_run",
        "clean",
        "suspicious",
        "malicious"
      ]
    },
    "prompt_injection_scan_status": {
      "enum": [
        "not_run",
        "clean",
        "suspicious",
        "quarantined"
      ]
    },
    "ingested_at": {
      "type": "string",
      "format": "date-time"
    },
    "provenance_manifest_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "registration_id",
    "registration_hash",
    "source_blob_artifact_id",
    "source_artifact_receipt_id",
    "registration_artifact_receipt_id",
    "derived_from_registration_id",
    "supersedes_document_manifest_id",
    "lineage_event_ids",
    "document_id",
    "paper_id",
    "paper_version_id",
    "content_hash",
    "original_filename",
    "media_type",
    "source_uri",
    "doi",
    "bibliographic_version",
    "supersedes_version_id",
    "status",
    "license_status",
    "access_policy_ref",
    "parser_artifact_ids",
    "source_integrity_report_id",
    "malware_scan_status",
    "prompt_injection_scan_status",
    "ingested_at",
    "provenance_manifest_id"
  ],
  "x-semantic-invariants": [
    "derived_from_registration_id == registration_id",
    "registration_hash and source_blob_artifact_id resolve to the immutable DocumentRegistration",
    "a new manifest revision never mutates or replaces its source DocumentRegistration"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epistemic-foundry.local/schemas/mechanism-graph.schema.json",
  "title": "MechanismGraph",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "mechanism_graph_id": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1
          },
          "concept_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "cause",
              "mediator",
              "moderator",
              "outcome",
              "confounder",
              "measurement"
            ]
          }
        },
        "required": [
          "node_id",
          "concept_id",
          "role"
        ]
      },
      "minItems": 1
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "edge_id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "enum": [
              "causes",
              "mediates",
              "moderates",
              "inhibits",
              "enables",
              "correlates",
              "measures"
            ]
          },
          "sign": {
            "enum": [
              "positive",
              "negative",
              "unknown"
            ]
          },
          "lag": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "edge_id",
          "source",
          "target",
          "relation",
          "sign",
          "lag"
        ]
      },
      "minItems": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "identification_status": {
      "enum": [
        "NOT_ASSESSED",
        "IDENTIFIED",
        "ASSUMPTION_DEPENDENT",
        "NOT_IDENTIFIED"
      ]
    },
    "graph_hash": {
      "type": "string",
      "minLength": 1,
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "mechanism_graph_id",
    "nodes",
    "edges",
    "assumptions",
    "identification_status",
    "graph_hash"
  ],
  "description": "가설의 기전 노드·방향·가정·시간 순서를 타입화한다."
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epistemic-foundry.local/schemas/gate-decision.schema.json",
  "title": "GateDecision",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "gate_id": {
      "type": "string"
    },
    "gate_version": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCK",
        "WAIVE"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "input_artifact_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "policy_bundle_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "decision": {
      "type": "string",
      "minLength": 1,
      "description": "Stable gate conclusion such as PASS, FAIL, BLOCK, WAIVE, or policy-evidenced NOT_REQUIRED."
    },
    "blocker_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "waiver_authority": {
      "type": [
        "string",
        "null"
      ]
    },
    "waiver_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "non_waivable": {
      "type": "boolean"
    },
    "evaluator_type": {
      "enum": [
        "deterministic",
        "human",
        "model_assisted",
        "formal_verifier"
      ]
    },
    "input_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "decision_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "gate_id",
    "gate_version",
    "run_id",
    "name",
    "status",
    "reasons",
    "evidence_ids",
    "input_artifact_ids",
    "policy_bundle_hash",
    "decision",
    "blocker_ids",
    "waiver_authority",
    "waiver_reason",
    "evaluated_at",
    "created_at",
    "policy_version",
    "non_waivable",
    "evaluator_type",
    "input_hash",
    "decision_hash"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "non_waivable": {
            "const": true
          }
        },
        "required": [
          "non_waivable"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCK"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "WAIVE"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "non_waivable": {
            "const": false
          },
          "waiver_authority": {
            "type": "string",
            "minLength": 1
          },
          "waiver_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "waiver_authority": {
            "type": "null"
          },
          "waiver_reason": {
            "type": "null"
          }
        }
      }
    }
  ]
}

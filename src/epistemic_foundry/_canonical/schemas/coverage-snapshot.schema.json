{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epistemic-foundry.local/schemas/coverage-snapshot.schema.json",
  "title": "CoverageSnapshot",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "axis_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "buckets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "axis_id",
        "label",
        "buckets"
      ]
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coordinate": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "search_state": {
          "enum": [
            "UNSEARCHED",
            "PARTIAL",
            "SEARCHED_NONE",
            "SEARCHED_WITH_RESULTS"
          ]
        },
        "support_count": {
          "type": "integer",
          "minimum": 0
        },
        "counter_count": {
          "type": "integer",
          "minimum": 0
        },
        "null_count": {
          "type": "integer",
          "minimum": 0
        },
        "boundary_count": {
          "type": "integer",
          "minimum": 0
        },
        "method_count": {
          "type": "integer",
          "minimum": 0
        },
        "independent_cluster_count": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "gap_labels": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "coordinate",
        "search_state",
        "support_count",
        "counter_count",
        "null_count",
        "boundary_count",
        "method_count",
        "independent_cluster_count",
        "evidence_ids",
        "gap_labels"
      ]
    }
  },
  "properties": {
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "insight_id": {
      "type": "string",
      "minLength": 1
    },
    "insight_revision": {
      "type": "integer",
      "minimum": 1
    },
    "corpus_snapshot_hash": {
      "$ref": "#/$defs/sha256"
    },
    "axes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/axis"
      }
    },
    "cells": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cell"
      }
    },
    "lens_entropy": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "dominant_lens": {
      "type": [
        "string",
        "null"
      ]
    },
    "unsearched_scopes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "provenance_manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "search_lane_receipt_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "bias_risk_register_id": {
      "type": "string",
      "minLength": 1
    },
    "coverage_certificate_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "effective_independent_evidence_count": {
      "type": "number",
      "minimum": 0
    },
    "stale": {
      "type": "boolean"
    }
  },
  "required": [
    "snapshot_id",
    "insight_id",
    "insight_revision",
    "corpus_snapshot_hash",
    "axes",
    "cells",
    "lens_entropy",
    "dominant_lens",
    "unsearched_scopes",
    "created_at",
    "provenance_manifest_id",
    "search_lane_receipt_ids",
    "bias_risk_register_id",
    "coverage_certificate_hash",
    "effective_independent_evidence_count",
    "stale"
  ]
}

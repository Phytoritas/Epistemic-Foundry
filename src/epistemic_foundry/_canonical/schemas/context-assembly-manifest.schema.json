{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epistemic-foundry.local/schemas/context-assembly-manifest.schema.json",
  "title": "ContextAssemblyManifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "manifest_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "node_id": {
      "type": "string"
    },
    "agent_role": {
      "type": "string"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "excluded_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "query_hashes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "ranking_version": {
      "type": "string"
    },
    "ontology_version": {
      "type": "string"
    },
    "prompt_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "model_identifier": {
      "type": "string"
    },
    "model_parameters": {
      "type": "object"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_trust_labels": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "trusted",
          "untrusted",
          "quarantined"
        ]
      }
    },
    "injection_scan_report_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "redaction_policy_version": {
      "type": "string",
      "minLength": 1
    },
    "token_accounting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instruction_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "tool_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "instruction_tokens",
        "evidence_tokens",
        "tool_tokens",
        "total_tokens"
      ]
    },
    "context_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ordering_strategy": {
      "enum": [
        "role_acl_then_relevance",
        "relevance",
        "chronological",
        "hybrid"
      ]
    }
  },
  "required": [
    "manifest_id",
    "run_id",
    "node_id",
    "agent_role",
    "evidence_ids",
    "excluded_evidence_ids",
    "query_hashes",
    "ranking_version",
    "ontology_version",
    "prompt_hash",
    "model_identifier",
    "model_parameters",
    "created_at",
    "source_trust_labels",
    "injection_scan_report_id",
    "redaction_policy_version",
    "token_accounting",
    "context_hash",
    "ordering_strategy"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epistemic-foundry.local/schemas/action-intent.schema.json",
  "title": "ActionIntent",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "intent_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "node_id": {
      "type": "string",
      "minLength": 1
    },
    "action_type": {
      "type": "string",
      "minLength": 1
    },
    "target_ref": {
      "type": "string",
      "minLength": 1
    },
    "arguments_artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "arguments_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "required_capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "approval_record_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_class": {
      "enum": [
        "read_only",
        "bounded_compute",
        "controlled_effect",
        "high_risk"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "intent_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "intent_id",
    "run_id",
    "node_id",
    "action_type",
    "target_ref",
    "arguments_artifact_id",
    "arguments_hash",
    "idempotency_key",
    "required_capabilities",
    "approval_record_ids",
    "risk_class",
    "created_at",
    "intent_hash"
  ]
}

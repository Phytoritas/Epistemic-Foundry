{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epistemic-foundry.local/schemas/evidence-node.schema.json",
  "title": "EvidenceNode",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]*-[A-Za-z0-9._:-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source_locator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paper_version_id": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Page number in the source document, or null when the extraction carries no page geometry. A null page requires coordinate_system 'not_available' and a null bbox; it is never a substitute for an unextracted page."
        },
        "section": {
          "type": [
            "string",
            "null"
          ]
        },
        "bbox": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "coordinate_system": {
          "enum": [
            "pdf_points_bottom_left",
            "pdf_points_top_left",
            "normalized_top_left",
            "not_available"
          ],
          "description": "Coordinate frame for bbox. 'not_available' declares an extraction with no page geometry and is mandatory when page is null."
        },
        "char_start": {
          "type": "integer",
          "minimum": 0
        },
        "char_end": {
          "type": "integer",
          "minimum": 1
        },
        "passage_hash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "paper_version_id",
        "page",
        "char_start",
        "char_end",
        "passage_hash"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "page": {
                "type": "null"
              }
            },
            "required": [
              "page"
            ]
          },
          "then": {
            "properties": {
              "coordinate_system": {
                "const": "not_available"
              },
              "bbox": {
                "type": "null"
              }
            },
            "required": [
              "coordinate_system"
            ]
          }
        }
      ]
    },
    "quality_vector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "directness": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "design_strength": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "measurement_validity": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "statistical_precision": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "replication": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "independence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "scope_match": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "extraction_confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "directness",
        "design_strength",
        "measurement_validity",
        "statistical_precision",
        "replication",
        "independence",
        "scope_match",
        "extraction_confidence"
      ]
    }
  },
  "properties": {
    "evidence_id": {
      "$ref": "#/$defs/id"
    },
    "claim_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "source_spans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source_locator"
      }
    },
    "experiment_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "role": {
      "enum": [
        "support",
        "counter",
        "null",
        "boundary",
        "mechanism",
        "method",
        "replication",
        "limitation"
      ]
    },
    "scope": {
      "$ref": "scope-vector.schema.json"
    },
    "method_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dataset_family_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "quality": {
      "$ref": "#/$defs/quality_vector"
    },
    "status": {
      "enum": [
        "candidate",
        "verified",
        "rejected",
        "superseded"
      ]
    },
    "provenance_manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_class": {
      "enum": [
        "primary_empirical",
        "secondary_empirical",
        "modeling",
        "formal",
        "benchmark",
        "review",
        "background",
        "methodological",
        "user_generated"
      ]
    },
    "dependency_cluster_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "bias_flags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validity_status": {
      "enum": [
        "active",
        "stale",
        "invalidated",
        "quarantined"
      ]
    },
    "source_integrity_report_id": {
      "type": "string",
      "minLength": 1
    },
    "lifecycle_event_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "evidence_id",
    "claim_ids",
    "source_spans",
    "experiment_id",
    "role",
    "scope",
    "method_ids",
    "dataset_family_id",
    "quality",
    "status",
    "provenance_manifest_id",
    "evidence_class",
    "dependency_cluster_ids",
    "bias_flags",
    "validity_status",
    "source_integrity_report_id",
    "lifecycle_event_ids"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epistemic-foundry.local/contracts/mcp/t02/schemas/tools/claim-promote.input.schema.json",
  "title": "ClaimPromoteInput",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "$ref": "../common-mutation-input.schema.json"
    }
  ],
  "properties": {
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "dry_run": {
      "type": "boolean"
    },
    "expected_revision": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "approval_record_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "target_ref": {
      "type": "string",
      "minLength": 1
    },
    "arguments": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "requested_level": {
          "enum": [
            "INBOX",
            "CANDIDATE",
            "LITERATURE_GROUNDED",
            "VALIDATION_SCREENED",
            "EMPIRICALLY_TESTED",
            "REPLICATED"
          ]
        },
        "promotion_pack_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "candidate_id",
        "promotion_pack_hash",
        "requested_level"
      ]
    }
  },
  "required": [
    "workspace_id",
    "dry_run",
    "expected_revision",
    "idempotency_key",
    "approval_record_ids",
    "target_ref",
    "arguments"
  ]
}

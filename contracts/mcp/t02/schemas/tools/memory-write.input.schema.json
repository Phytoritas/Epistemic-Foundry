{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epistemic-foundry.local/contracts/mcp/t02/schemas/tools/memory-write.input.schema.json",
  "title": "MemoryWriteInput",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "$ref": "../common-mutation-input.schema.json"
    }
  ],
  "properties": {
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "dry_run": {
      "type": "boolean"
    },
    "expected_revision": {
      "type": "null"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "approval_record_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "target_ref": {
      "type": "string",
      "minLength": 1
    },
    "arguments": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "memory_class": {
          "enum": [
            "USER",
            "PROJECT",
            "SESSION",
            "SKILL",
            "SYSTEM",
            "EPHEMERAL"
          ]
        },
        "consent_record_id": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "consent_record_id",
        "content_hash",
        "memory_class"
      ]
    }
  },
  "required": [
    "workspace_id",
    "dry_run",
    "expected_revision",
    "idempotency_key",
    "approval_record_ids",
    "target_ref",
    "arguments"
  ]
}

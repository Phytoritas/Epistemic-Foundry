{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epistemic-foundry.local/contracts/mcp/t01/foundry-mcp-tool-result.schema.json",
  "title": "FoundryMcpToolResult",
  "description": "Shared MCP tool result envelope for every T01 read and planning tool on every transport. Scientific payloads validate against the canonical domain schemas referenced in data_schema_refs; this envelope never re-declares them (EF4-I22).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": "2026-07-28"
    },
    "tool": {
      "type": "string",
      "pattern": "^foundry\\.[a-z][a-z_]*(\\.[a-z][a-z_]*)*$"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "read_model_state": {
      "enum": [
        "READY",
        "EMPTY_CONFIRMED",
        "DEGRADED",
        "UNAVAILABLE"
      ]
    },
    "data": {
      "type": [
        "object",
        "null"
      ]
    },
    "data_schema_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^https://epistemic-foundry\\.local/schemas/[a-z0-9-]+\\.schema\\.json$"
      },
      "uniqueItems": true
    },
    "receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "receipt_id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "artifact_id",
          "receipt_id",
          "sha256"
        ]
      }
    },
    "degradation_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "protocol_version",
    "tool",
    "request_id",
    "workspace_id",
    "read_model_state",
    "data",
    "data_schema_refs",
    "receipts",
    "degradation_reason",
    "generated_at"
  ]
}

{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/dist/hook-runner.mjs\" evolution-pre-tool",
            "timeout": 12,
            "statusMessage": "(Epistemic Foundry) Checking evolution sandbox and sealed evaluator boundary"
          }
        ],
        "matcher": "Bash|mcp__efoundry__evolve.*|Agent"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/dist/hook-runner.mjs\" evolution-post-tool",
            "timeout": 15,
            "statusMessage": "(Epistemic Foundry) Reconciling candidate and effect receipts"
          }
        ],
        "matcher": "Bash|mcp__efoundry__evolve.*|Agent"
      }
    ]
  }
}

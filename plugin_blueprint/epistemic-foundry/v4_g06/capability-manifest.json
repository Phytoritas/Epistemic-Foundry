  "required_capabilities": ["plugin_cli", "plugin_hooks", "plugin_skills"],
  "optional_capabilities": ["hosted_tool_hooks", "plugin_mcp"],
  "degraded_modes": [
    {
      "missing_capability": "hosted_tool_hooks",
      "mode": "READ_ONLY",
      "behavior": "Hosted-tool observation is unavailable; affected tool paths are surfaced read-only and gated by the kernel rather than by host hooks."
    },
    {
      "missing_capability": "plugin_hooks",
      "mode": "DEGRADED",
      "behavior": "Host hook enforcement is unavailable; kernel gates and the explicit CLI remain the authoritative control path."
    },
    {
      "missing_capability": "plugin_mcp",
      "mode": "DEGRADED",
      "behavior": "The MCP transport is unavailable; the projected CLI surface remains the invocation path for every command."
    }
  ],

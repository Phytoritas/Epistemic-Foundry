{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epistemic-foundry.local/schemas/attestation.schema.json",
  "title": "Attestation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "attestation_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "attestor_id": {
      "type": "string",
      "minLength": 1
    },
    "attestor_type": {
      "enum": [
        "human",
        "model",
        "service",
        "formal_verifier"
      ]
    },
    "input_artifact_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCK",
              "NOT_APPLICABLE"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "check_id",
          "status",
          "reason"
        ]
      }
    },
    "overall_status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCK"
      ]
    },
    "independence_statement": {
      "type": "string",
      "minLength": 1
    },
    "model_or_identity_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "attestation_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "signature": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "attestation_id",
    "run_id",
    "subject_artifact_id",
    "attestor_id",
    "attestor_type",
    "input_artifact_ids",
    "checks",
    "overall_status",
    "independence_statement",
    "model_or_identity_version",
    "created_at",
    "attestation_hash",
    "signature"
  ]
}

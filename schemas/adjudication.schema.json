{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epistemic-foundry.local/schemas/adjudication.schema.json",
  "title": "Adjudication",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "adjudication_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "hypothesis_id": {
      "type": "string",
      "minLength": 1
    },
    "gate_decision_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "brief_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "cross_examination_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "minority_report_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verdict": {
      "enum": [
        "ENTAILED",
        "SUPPORTED",
        "CONDITIONAL",
        "MIXED",
        "CONTRADICTED",
        "UNDERDETERMINED",
        "UNTESTABLE"
      ]
    },
    "scope_narrowing": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "strongest_support_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "strongest_counterevidence_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "unresolved_issue_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "promotion_recommendation": {
      "enum": [
        "BLOCK",
        "INBOX",
        "CANDIDATE",
        "LITERATURE_GROUNDED",
        "VALIDATION_SCREENED",
        "EMPIRICALLY_TESTED",
        "REPLICATED"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "deterministic_gate_override_attempted": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "adjudication_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "adjudication_id",
    "run_id",
    "hypothesis_id",
    "gate_decision_ids",
    "brief_ids",
    "cross_examination_ids",
    "minority_report_ids",
    "verdict",
    "scope_narrowing",
    "strongest_support_id",
    "strongest_counterevidence_id",
    "unresolved_issue_ids",
    "promotion_recommendation",
    "rationale",
    "deterministic_gate_override_attempted",
    "created_at",
    "adjudication_hash"
  ]
}

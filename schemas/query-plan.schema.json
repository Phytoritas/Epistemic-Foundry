{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epistemic-foundry.local/schemas/query-plan.schema.json",
  "title": "QueryPlan",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "query_plan_id": {
      "type": "string",
      "minLength": 1
    },
    "insight_id": {
      "type": "string",
      "minLength": 1
    },
    "insight_revision": {
      "type": "integer",
      "minimum": 1
    },
    "canonical_relation": {
      "type": "string",
      "minLength": 1
    },
    "forward_queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "reverse_queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "null_queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "boundary_queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "method_queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "novelty_queries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope_partitions": {
      "type": "array",
      "items": {
        "$ref": "scope-vector.schema.json"
      }
    },
    "required_lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_queries": {
          "type": "integer",
          "minimum": 1
        },
        "max_documents": {
          "type": "integer",
          "minimum": 1
        },
        "max_seconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "max_queries",
        "max_documents",
        "max_seconds"
      ]
    },
    "stop_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "planner_prompt_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "query_plan_id",
    "insight_id",
    "insight_revision",
    "canonical_relation",
    "forward_queries",
    "reverse_queries",
    "null_queries",
    "boundary_queries",
    "method_queries",
    "novelty_queries",
    "scope_partitions",
    "required_lanes",
    "budget",
    "stop_rules",
    "planner_prompt_hash",
    "created_at"
  ]
}

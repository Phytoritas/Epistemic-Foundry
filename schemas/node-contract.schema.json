{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epistemic-foundry.local/schemas/node-contract.schema.json",
  "title": "NodeContract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "node_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "executor_type": {
      "enum": [
        "deterministic",
        "llm",
        "parser",
        "retrieval",
        "sandbox",
        "subworkflow",
        "policy",
        "human_gate"
      ]
    },
    "executor_ref": {
      "type": "string",
      "minLength": 1
    },
    "input_schema_ref": {
      "type": "string",
      "minLength": 1
    },
    "output_schema_ref": {
      "type": "string",
      "minLength": 1
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "read_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "write_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "model_tier": {
      "enum": [
        "deterministic",
        "economy",
        "balanced",
        "frontier"
      ]
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "failure_policy": {
      "enum": [
        "fail_run",
        "mark_partial",
        "skip_downstream",
        "escalate"
      ]
    },
    "acceptance_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "resource_dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "determinism_class": {
      "enum": [
        "deterministic",
        "seeded_nondeterministic",
        "provider_nondeterministic"
      ]
    },
    "idempotency_key_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "loop_contract_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "expected_effects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_policy_checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "node_id",
    "purpose",
    "executor_type",
    "executor_ref",
    "input_schema_ref",
    "output_schema_ref",
    "depends_on",
    "read_scope",
    "write_scope",
    "capabilities",
    "model_tier",
    "timeout_seconds",
    "max_attempts",
    "failure_policy",
    "acceptance_checks",
    "resource_dependencies",
    "determinism_class",
    "idempotency_key_fields",
    "loop_contract_ref",
    "expected_effects",
    "required_policy_checks"
  ]
}

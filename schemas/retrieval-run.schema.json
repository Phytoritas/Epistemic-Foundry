{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epistemic-foundry.local/schemas/retrieval-run.schema.json",
  "title": "RetrievalRun",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "retrieval_run_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_run_id": {
      "type": "string",
      "minLength": 1
    },
    "insight_id": {
      "type": "string",
      "minLength": 1
    },
    "query_plan_id": {
      "type": "string",
      "minLength": 1
    },
    "lane_receipt_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "required_lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "completed_lanes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocked_lanes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coverage_state": {
      "enum": [
        "COMPLETE_FOR_POLICY",
        "PARTIAL",
        "BLOCKED",
        "NOT_STARTED"
      ]
    },
    "effective_candidate_count": {
      "type": "integer",
      "minimum": 0
    },
    "deduplication_policy_version": {
      "type": "string",
      "minLength": 1
    },
    "ranking_policy_version": {
      "type": "string",
      "minLength": 1
    },
    "bias_risk_register_id": {
      "type": "string",
      "minLength": 1
    },
    "completeness_certificate_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "retrieval_run_id",
    "parent_run_id",
    "insight_id",
    "query_plan_id",
    "lane_receipt_ids",
    "required_lanes",
    "completed_lanes",
    "blocked_lanes",
    "coverage_state",
    "effective_candidate_count",
    "deduplication_policy_version",
    "ranking_policy_version",
    "bias_risk_register_id",
    "completeness_certificate_hash",
    "created_at"
  ]
}

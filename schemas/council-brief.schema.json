{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epistemic-foundry.local/schemas/council-brief.schema.json",
  "title": "CouncilBrief",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "brief_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "role": {
      "enum": [
        "defender",
        "prosecutor",
        "method_auditor",
        "scope_auditor",
        "inductivist",
        "deductivist",
        "causal_auditor",
        "novelty_examiner",
        "abductive_mediator",
        "bias_auditor",
        "other"
      ]
    },
    "blind": {
      "type": "boolean"
    },
    "context_manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "verdict_candidate": {
      "enum": [
        "ENTAILED",
        "SUPPORTED",
        "CONDITIONAL",
        "MIXED",
        "CONTRADICTED",
        "UNDERDETERMINED",
        "UNTESTABLE"
      ]
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "assertion_id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "argument_node_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scope_limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "assertion_id",
          "text",
          "evidence_ids",
          "argument_node_ids",
          "scope_limitations",
          "confidence"
        ]
      }
    },
    "strongest_counterargument": {
      "type": "string",
      "minLength": 1
    },
    "conditions_that_change_verdict": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "missing_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
    },
    "brief_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "brief_id",
    "run_id",
    "round",
    "role",
    "blind",
    "context_manifest_id",
    "verdict_candidate",
    "assertions",
    "strongest_counterargument",
    "conditions_that_change_verdict",
    "missing_evidence",
    "schema_version",
    "brief_hash",
    "created_at"
  ]
}

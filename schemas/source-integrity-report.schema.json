{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epistemic-foundry.local/schemas/source-integrity-report.schema.json",
  "title": "SourceIntegrityReport",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PASS",
              "WARN",
              "FAIL",
              "NOT_RUN"
            ]
          },
          "details": {
            "type": "string"
          },
          "evidence_artifact_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "check_id",
          "status",
          "details",
          "evidence_artifact_ids"
        ]
      }
    },
    "overall_status": {
      "enum": [
        "PASS",
        "WARN",
        "FAIL",
        "QUARANTINE"
      ]
    },
    "trusted_for_extraction": {
      "type": "boolean"
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "report_id",
    "document_id",
    "content_hash",
    "checks",
    "overall_status",
    "trusted_for_extraction",
    "evaluated_at",
    "policy_version"
  ]
}
